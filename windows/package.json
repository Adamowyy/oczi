{
  "name": "oczi",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "pack": "tauri build && node scripts/pack.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "voice:check": "node scripts/whisper-gnu.mjs check",
    "voice:build": "node scripts/whisper-gnu.mjs build",
    "voice:model": "node scripts/whisper-gnu.mjs model",
    "voice:pack": "node scripts/whisper-gnu.mjs stage && node scripts/whisper-gnu.mjs build && tauri build --features voice --config src-tauri/tauri.voice.conf.json && node scripts/pack.mjs voice"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
